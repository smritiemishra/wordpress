{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wp-travel-blocks/trip-whatsapp-enquiry-button",
  "version": "0.1.0",
  "title": "WhatsApp Enquiry Button",
  "category": "wp-travel-single-trip-blocks",
  "description": "Shows a Whatsapp Enquiry Button.",
  "example": {},
  "supports": {
    "html": false
  },
  "textdomain": "trip-whatsapp-enquiry-button",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "attributes": {
    "enableTourCountDown": {
      "type": "boolean",
      "default": false
    },
    "whatsappIconColor": {
      "type": "string",
      "default": ""
    },
    "whatsappLinkTextColor": {
      "type": "string",
      "default": ""
    },
    "buttonLabel": {
      "type": "string",
      "default": "Send Message"
    }
  }
}