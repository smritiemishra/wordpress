{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wp-travel-blocks/trip-custom-content",
  "version": "0.1.0",
  "title": "Trip Custom Content",
  "category": "wp-travel-single-trip-blocks",
  "icon": "index-card",
  "description": "Display trip custom content.",
  "attributes": {
    "textAlign": {
      "type": "string",
      "default": "left"
    },
    "tabContent": {
      "type": "string",
      "default": "1"
    },
    "tripContent": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false
  },
  "textdomain": "trip-custom-content",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}